;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AdventureGame"
run/main_scene="uid://trqgmmyo8yv0"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://8jirkptjfniv"

[autoload]

